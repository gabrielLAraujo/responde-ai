# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado para gerar as respostas. Para reduzir custo, use claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Postgres (no Coolify: crie um banco Postgres e copie a URL interna)
DATABASE_URL=postgres://usuario:senha@localhost:5432/respondeai
# Gerações grátis por IP por hora
FREE_LIMIT_PER_HOUR=10
