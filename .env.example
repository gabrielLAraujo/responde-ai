# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado para gerar as respostas. Para reduzir custo, use claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Postgres (no Coolify: crie um banco Postgres e copie a URL interna)
DATABASE_URL=postgres://usuario:senha@localhost:5432/respondeai
# Gerações grátis por IP por hora
FREE_LIMIT_PER_HOUR=10
# Gerações por usuário logado por hora
ACCOUNT_LIMIT_PER_HOUR=100
# Better Auth: segredo aleatório (openssl rand -base64 32) e URL pública do app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Cliente OAuth do Google (Google Cloud Console > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
